---
import { ViewTransitions } from "astro:transitions";
import "@fontsource-variable/montserrat";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
    simple?: boolean;
}

const {
    title,
    description = "Reitcom - Internet de Ultra Alta Velocidad",
    simple = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <SEO title={title} description={description} />
        <ViewTransitions />
    </head>
    <body
        class="bg-background text-text-main font-sans antialiased selection:bg-primary selection:text-white transition-colors duration-500 flex flex-col min-h-screen"
    >
        <!-- Skip to Content Link for A11y -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[200] bg-primary text-white px-6 py-3 rounded-full font-bold shadow-xl"
        >
            Saltar al contenido principal
        </a>

        {/* Conditionally render Header */}
        {!simple && <Header />}

        <main
            id="main-content"
            class="flex-grow focus:outline-none"
            tabindex="-1"
        >
            <slot />
        </main>

        {/* Conditionally render Footer */}
        {!simple && <Footer />}

        <style is:global>
            :root {
                /* Light Mode (Clean & Airy) */
                --bg-primary: #ffffff; /* Brand White */
                --bg-surface: #f8f9fa; /* Slight contrast for cards */
                --text-primary: #2e2d2c; /* Brand Neutral Dark */
                --text-secondary: #666666;
                --color-support: #BECOC2; /* Brand Support Gray */
                --border-color: rgba(0, 0, 0, 0.05);
                --glass-bg: rgba(255, 255, 255, 0.7);
                --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
            }

            @media (prefers-color-scheme: dark) {
                :root {
                    /* Dark Mode (Deep & Premium) */
                    --bg-primary: #050505; /* True Black */
                    --bg-surface: #121212;
                    --text-primary: #ffffff;
                    --text-secondary: #a1a1a4;
                    --border-color: rgba(255, 255, 255, 0.08);
                    --glass-bg: rgba(10, 10, 10, 0.7);
                    --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
                }
            }

            body {
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            /* Smooth Scrolling for Anchor Links */
            html {
                scroll-behavior: smooth;
                scroll-padding-top: 100px; /* Offset for fixed header */
            }

            /* Focus Visible for A11y */
            :focus-visible {
                outline: 2px solid var(--text-primary);
                outline-offset: 2px;
            }

            /* Premium Gradients */
            .text-gradient {
                background: linear-gradient(to right, #f9423a, #ffd700);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                color: transparent;
            }

            .bg-gradient-brand {
                background: linear-gradient(to right, #f9423a, #ffd700);
            }
        </style>
    </body>
</html>
