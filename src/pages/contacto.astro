---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Input from "../components/ui/Input.astro";
---

<Layout title="Contacto - Reitcom">
    <main class="pt-32 pb-32 container mx-auto px-6 max-w-[1400px]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
            <div>
                <h1
                    class="text-5xl md:text-7xl font-black text-text-main mb-8 tracking-tight"
                >
                    <span class="text-gradient">Hablemos.</span>
                </h1>
                <p
                    class="text-xl text-text-secondary mb-16 leading-relaxed max-w-lg"
                >
                    Estamos aquí para resolver tus dudas. Contáctanos por
                    cualquiera de nuestros canales oficiales.
                </p>

                <div class="space-y-10">
                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-16 h-16 rounded-2xl bg-surface border border-border flex items-center justify-center text-primary shrink-0 shadow-sm group-hover:scale-110 transition-transform duration-300"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-text-main mb-2">
                                Visítanos
                            </h3>
                            <p
                                class="text-text-secondary text-lg leading-relaxed"
                            >
                                Av. Principal y Calle 2, Edificio Reitcom<br
                                />Quito, Ecuador
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-16 h-16 rounded-2xl bg-surface border border-border flex items-center justify-center text-primary shrink-0 shadow-sm group-hover:scale-110 transition-transform duration-300"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-text-main mb-2">
                                Llámanos
                            </h3>
                            <p
                                class="text-text-secondary text-lg leading-relaxed"
                            >
                                +593 99 123 4567<br />02 234 5678
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div
                class="bg-surface/50 backdrop-blur-xl border border-white/20 dark:border-white/5 rounded-[2.5rem] p-10 md:p-14 shadow-2xl shadow-primary/5"
            >
                <form class="space-y-8">
                    <Input label="Nombre Completo" placeholder="Juan Pérez" />
                    <Input
                        label="Correo Electrónico"
                        type="email"
                        placeholder="juan@ejemplo.com"
                    />
                    <Input label="Asunto" placeholder="Información de Planes" />

                    <div class="flex flex-col gap-3 group">
                        <label
                            class="text-sm font-bold text-text-muted ml-2 transition-colors group-focus-within:text-primary"
                            >Mensaje</label
                        >
                        <textarea
                            class="w-full bg-surface/50 border border-transparent rounded-2xl px-6 py-4 text-text-main placeholder-text-muted/50 focus:outline-none focus:bg-surface focus:shadow-lg focus:shadow-primary/5 transition-all duration-300 h-40 resize-none"
                            placeholder="¿En qué podemos ayudarte?"></textarea>
                    </div>

                    <Button
                        class="w-full text-lg shadow-xl shadow-primary/20"
                        size="lg">Enviar Mensaje</Button
                    >
                </form>
            </div>
        </div>
    </main>
</Layout>
