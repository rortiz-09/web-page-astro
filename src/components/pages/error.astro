---
// src/pages/error.astro
import Layout from "../../layouts/Layout.astro"

const { currentLocale } = Astro;
---

<Layout
  title="Error 404 - Reitcom"
  description="Lo sentimos, la página que estás buscando no existe. Explora otras secciones de nuestro sitio web para encontrar lo que necesitas."
  showHeader={false}
  showFooter={false}
>
  <main class="flex flex-col items-center justify-center h-screen text-center">
    <h1 class="text-6xl font-bold text-red-orange-500 mb-8">404</h1>
    <p class="text-xl mb-6">Lo sentimos, la página que estás buscando no existe.</p>
    <a href="/" class="text-red-orange-500 underline">Volver a la página principal</a>
  </main>
</Layout>