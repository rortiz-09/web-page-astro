---
import Logo from "./Logo.astro";

const navItems = [
    { name: "Inicio", href: "/" },
    { name: "Hogar", href: "/planes/hogar" },
    { name: "Empresas", href: "/planes/pyme" },
    { name: "Nosotros", href: "/nosotros" },
    { name: "Cobertura", href: "/cobertura" },
];
---

<header
    id="main-header"
    class="fixed top-0 left-0 right-0 z-[100] transition-all duration-500 border-b border-transparent py-4"
>
    <div class="mx-auto max-w-[1400px] px-6 md:px-12">
        <div
            class="flex h-16 items-center justify-between rounded-full px-6 transition-all duration-500"
            id="header-container"
        >
            <!-- Logo -->
            <a
                href="/"
                class="flex items-center gap-2 group"
                aria-label="Reitcom Home"
            >
                <Logo
                    class="h-8 w-auto text-text-main transition-transform duration-500 group-hover:scale-105"
                />
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center gap-10">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="text-sm font-bold text-text-secondary hover:text-primary transition-colors relative group tracking-wide"
                        >
                            {item.name}
                            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full rounded-full" />
                        </a>
                    ))
                }
            </nav>

            <!-- Actions -->
            <div class="hidden md:flex items-center gap-6">
                <a
                    href="/contacto"
                    class="text-sm font-bold text-text-secondary hover:text-text-main transition-colors"
                >
                    Soporte
                </a>
                <a
                    href="/contacto"
                    class="bg-primary text-white px-5 py-2.5 rounded-full text-sm font-bold hover:bg-primary-hover transition-colors shadow-lg shadow-primary/20"
                >
                    Contratar
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden text-text-main p-2 focus:outline-none"
                aria-label="Menu"
            >
                <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div
        id="mobile-menu"
        class="fixed inset-0 z-[90] bg-background/95 backdrop-blur-2xl opacity-0 pointer-events-none transition-all duration-500 flex flex-col items-center justify-center gap-8"
    >
        <button
            id="close-menu-btn"
            class="absolute top-8 right-8 text-text-secondary hover:text-text-main p-2"
            aria-label="Cerrar Menú"
        >
            <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        {
            navItems.map((item, index) => (
                <a
                    href={item.href}
                    class="text-4xl font-black text-text-main hover:text-primary transition-all duration-300 tracking-tight transform translate-y-4 opacity-0"
                    style={`transition-delay: ${index * 100}ms`}
                >
                    {item.name}
                </a>
            ))
        }
        <div
            class="flex flex-col gap-4 mt-8 w-64 transform translate-y-4 opacity-0 transition-all duration-300 delay-500 mobile-action"
        >
            <a
                href="/contacto"
                class="w-full bg-primary text-white py-3 rounded-xl font-bold text-center hover:bg-primary-hover transition-colors shadow-lg shadow-primary/20"
            >
                Contratar Ahora
            </a>
        </div>
    </div>
</header>

<script>
    document.addEventListener("astro:page-load", () => {
        const header = document.getElementById("main-header");
        const container = document.getElementById("header-container");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const closeBtn = document.getElementById("close-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");

        // Scroll Effect
        const handleScroll = () => {
            if (window.scrollY > 20) {
                header?.classList.remove("py-4");
                header?.classList.add("py-2");
                container?.classList.add(
                    "bg-white/80",
                    "dark:bg-black/80",
                    "backdrop-blur-xl",
                    "shadow-sm",
                    "border",
                    "border-white/20",
                );
            } else {
                header?.classList.add("py-4");
                header?.classList.remove("py-2");
                container?.classList.remove(
                    "bg-white/80",
                    "dark:bg-black/80",
                    "backdrop-blur-xl",
                    "shadow-sm",
                    "border",
                    "border-white/20",
                );
            }
        };

        window.addEventListener("scroll", handleScroll);
        // Initial check in case we land on a scrolled page
        handleScroll();

        // Mobile Menu
        function toggleMenu() {
            const isOpen = mobileMenu?.classList.contains("opacity-100");
            const links = mobileMenu?.querySelectorAll("a");
            const action = mobileMenu?.querySelector(".mobile-action");

            if (isOpen) {
                // Close
                mobileMenu?.classList.remove(
                    "opacity-100",
                    "pointer-events-auto",
                );
                mobileMenu?.classList.add("opacity-0", "pointer-events-none");
                document.body.classList.remove("overflow-hidden");

                // Reset animations
                links?.forEach((link) => {
                    link.classList.remove("translate-y-0", "opacity-100");
                    link.classList.add("translate-y-4", "opacity-0");
                });
                action?.classList.remove("translate-y-0", "opacity-100");
                action?.classList.add("translate-y-4", "opacity-0");
            } else {
                // Open
                mobileMenu?.classList.remove(
                    "opacity-0",
                    "pointer-events-none",
                );
                mobileMenu?.classList.add("opacity-100", "pointer-events-auto");
                document.body.classList.add("overflow-hidden");

                // Trigger animations
                setTimeout(() => {
                    links?.forEach((link) => {
                        link.classList.remove("translate-y-4", "opacity-0");
                        link.classList.add("translate-y-0", "opacity-100");
                    });
                    action?.classList.remove("translate-y-4", "opacity-0");
                    action?.classList.add("translate-y-0", "opacity-100");
                }, 100);
            }
        }

        mobileBtn?.addEventListener("click", toggleMenu);
        closeBtn?.addEventListener("click", toggleMenu);
    });
</script>
