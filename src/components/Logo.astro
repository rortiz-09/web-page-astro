---
interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<svg
    class={className}
    viewBox="0 0 200 50"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
>
    <!-- Placeholder for Reitcom Logo - Using Text for now to ensure visibility -->
    <text
        x="0"
        y="35"
        font-family="Montserrat"
        font-weight="900"
        font-size="32"
        fill="currentColor"
    >
        REITCOM
    </text>
    <circle cx="180" cy="25" r="5" fill="#F9423A"></circle>
</svg>
