        rating: 4,
    },
    {
        name: "María L.",
        role: "Profesora Online",
        content:
            "Mis clases por Zoom son fluidas y sin interrupciones. Mis alumnos me escuchan y ven perfectamente.",
        avatar: "M",
        color: "bg-pink-500",
        rating: 5,
    },
    {
        name: "Café Central",
