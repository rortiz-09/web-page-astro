---

<section class="py-32 bg-surface relative overflow-hidden">
    <div class="container mx-auto px-6 max-w-[1400px] mb-12 text-center">
        <h2
            class="text-4xl md:text-5xl font-black text-text-main mb-6 tracking-tight"
        >
            Lo que dicen nuestros clientes
        </h2>
        <p class="text-xl text-text-secondary max-w-2xl mx-auto">
            Personas reales, experiencias reales. Únete a la comunidad mejor
            conectada.
        </p>
    </div>

    <!-- Marquee Container -->
    <div class="relative w-full overflow-hidden mask-gradient">
        <div
            class="flex gap-16 w-max animate-marquee hover:pause"
            id="testimonials-track"
        >
            {
                testimonials.map((t) => (
                    <Card
                        class="testimonial-card w-[350px] h-[350px] p-8 flex flex-col justify-between shrink-0"
                        glass={true}
                        hover={true}
                    >
                        <div>
                            <div class="flex items-center gap-4 mb-6">
                                <div
                                    class={`w-12 h-12 rounded-full ${t.color} flex items-center justify-center text-white font-bold text-xl shadow-lg shrink-0`}
                                >
                                    {t.avatar}
                                </div>
                                <div>
                                    <h4 class="font-bold text-text-main text-lg leading-tight">
                                        {t.name}
                                    </h4>
                                    <p class="text-sm text-text-secondary font-medium">
                                        {t.role}
                                    </p>
                                </div>
                            </div>
                            <p class="text-text-main text-base leading-relaxed italic line-clamp-5">
                                "{t.content}"
                            </p>
                        </div>

                        <div class="flex gap-1 mt-4">
                            {Array.from({ length: t.rating }).map(() => (
                                <svg
                                    class="w-5 h-5 text-yellow-400 fill-current"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                            {Array.from({ length: 5 - t.rating }).map(() => (
                                <svg
                                    class="w-5 h-5 text-gray-300 fill-current"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                    </Card>
                ))
            }
        </div>
    </div>
</section>

<style>
    .mask-gradient {
        mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
    }

    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .animate-marquee {
        animation: marquee 120s linear infinite;
    }

    .hover\:pause:hover {
        animation-play-state: paused;
    }
</style>

<script>
    // Randomize testimonials on load
    const track = document.getElementById("testimonials-track");

    if (track) {
        // 1. Get all cards
        const cards = Array.from(track.children);

        // 2. Shuffle them
        for (let i = cards.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [cards[i], cards[j]] = [cards[j], cards[i]];
        }

        // 3. Re-append shuffled cards
        cards.forEach((card) => track.appendChild(card));

        // 4. Clone for infinite loop (append a copy of the shuffled list)
        cards.forEach((card) => {
            const clone = card.cloneNode(true);
            track.appendChild(clone);
        });
    }
</script>
