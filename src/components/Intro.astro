---
import Button from "./ui/Button.astro";
---

<section
    class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20 pb-20 bg-background transition-colors duration-500"
>
    <!-- Background Effects -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 rounded-full blur-[120px] animate-pulse"
        >
        </div>
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-secondary/5 rounded-full blur-[100px] opacity-50"
        >
        </div>

        <!-- Optional: Subtle pattern or texture could go here -->
        <div
            class="absolute inset-0 bg-[url('/background.webp')] opacity-[0.03] bg-cover bg-center mix-blend-overlay"
        >
        </div>
    </div>

    <div class="relative z-10 container mx-auto px-6 text-center max-w-5xl">
        <div
            class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-surface/80 backdrop-blur-md border border-border mb-12 animate-fade-in-down duration-700 shadow-sm hover:shadow-md transition-all cursor-default"
        >
            <span class="relative flex h-3 w-3">
                <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"
                ></span>
                <span
                    class="relative inline-flex rounded-full h-3 w-3 bg-secondary"
                ></span>
            </span>
            <span class="text-sm font-bold text-text-secondary tracking-wide"
                >La red de fibra #1 en Ecuador</span
            >
        </div>

        <h1
            class="text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter text-text-main mb-10 animate-fade-in-up duration-700 delay-100 text-balance leading-[0.9]"
        >
            Velocidad que <br />
            <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary animate-gradient-x"
            >
                Renace.
            </span>
        </h1>

        <p
            class="text-xl md:text-2xl text-text-secondary max-w-3xl mx-auto mb-16 animate-fade-in-up duration-700 delay-200 text-balance font-medium leading-relaxed"
        >
            Experimenta la verdadera fibra óptica simétrica. <br
                class="hidden md:block"
            />
            Sin interrupciones. Sin límites. Solo conexión pura.
        </p>

        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in-up duration-700 delay-300"
        >
            <Button
                href="/Planes"
                size="xl"
                class="w-full sm:w-auto shadow-2xl shadow-primary/20 hover:scale-105 transition-transform duration-300"
            >
                Ver Planes
            </Button>
            <Button
                href="/cobertura"
                variant="secondary"
                size="xl"
                class="w-full sm:w-auto hover:scale-105 transition-transform duration-300"
            >
                Verificar Cobertura
            </Button>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce text-text-secondary opacity-50 duration-1000"
    >
        <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
        >
    </div>
</section>
